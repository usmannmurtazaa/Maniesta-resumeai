rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdmin() {
      return isSignedIn() && request.auth.token.admin == true;
    }
    function ownsDocument(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Users collection
    match /users/{userId} {
      allow read: if ownsDocument(userId) || isAdmin();
      allow create: if ownsDocument(userId) &&
        request.resource.data.keys().hasOnly(['jobPreferences', 'lastSeenJobsAt', 'savedJobs']);
      allow update: if ownsDocument(userId) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['jobPreferences', 'lastSeenJobsAt', 'savedJobs']);
      allow delete: if false;
    }

    // Resumes collection
    match /resumes/{resumeId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid; // no transfer of ownership
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // Jobs collection
    match /jobs/{jobId} {
      allow read: if isSignedIn() && (resource.data.status == 'published' || isAdmin());
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false; // only server-side functions
      allow update: if isSignedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    }

    // ATS analysis history (if used)
    match /atsAnalyses/{analysisId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if false; // server-side only
      allow update: if false;
      allow delete: if false;
    }

    // Admin logs (audit trail)
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if false; // server-side only
    }
  }
}